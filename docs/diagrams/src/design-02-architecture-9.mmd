flowchart TB
  MOD["agents/patent/<br/>agent.py, checks.py, prompts/"] --> LD["Agent loader"]
  LD -->|"scan imports: only aksha.runtime.api<br/>and named extensions"| V["Definition validation<br/>(fixed order of refusals)"]
